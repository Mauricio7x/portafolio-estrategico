    "formulas": {
      "mano_obra": "(precio_base × prestacional) ÷ rendimiento",
      "materiales": "precio_base × cantidad_por_unidad × (1 + desperdicio)",
      "equipo": "precio_base ÷ rendimiento",
      "transporte": "precio_base × cantidad_por_unidad × distancia_km",
      "herramienta_menor": "herramienta_menor_pct × (total del capítulo de mano de obra)",
      "costo_directo": "mano_obra + materiales + equipo + herramienta_menor + transporte",
      "precio_unitario": "costo_directo × (1 + aiu)",
      "nota_rendimiento": "unidades de obra por DÍA para insumos tarifados por día; por HORA para los tarifados por hora. La unidad del insumo manda.",
      "nota_transporte": "cantidad_por_unidad de una línea de transporte va SIEMPRE en m³ de material movido por unidad del ítem. Pasarle kilogramos era el error de la fuente recuperada (ver docs/APU_Y_RENTABILIDAD.md §1)."
